generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  subject       String
  gradeLevel    String
  createdAt     DateTime      @default(now())
  sessions      Session[]
  lessonPlans   LessonPlan[]
  role          String        @default("user")
  disabled              Boolean       @default(false)
  subscriptionExpiresAt DateTime?
}

model Session {
  id          String       @id @default(cuid())
  title       String
  messages    Json
  subject     String
  planType    String       @default("lesson") 
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  userId      String
  lessonPlan  LessonPlan?
}

model LessonPlan {
  id          String    @id @default(cuid())
  structure   Json
  blobUrl     String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  session     Session   @relation(fields: [sessionId], references: [id])
  sessionId   String    @unique
}

model PromptTemplate {
  id          String   @id @default(cuid())
  subject     String   @unique
  template    String
  temperature Float    @default(0.7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String   // e.g. USER_LOGIN, USER_CREATE, USER_SUSPEND, USER_ACTIVATE, ROLE_CHANGE, SUBSCRIPTION_EXTEND, SUBSCRIPTION_REVOKE, PROMPT_CREATE, PROMPT_UPDATE, EXPORT_PLAN
  actorId    String
  actorEmail String
  actorName  String
  targetId   String?
  targetName String?  // Target email/name or prompt subject
  details    Json?
  createdAt  DateTime @default(now())
}
