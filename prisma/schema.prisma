generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  subject       String
  gradeLevel    String
  createdAt     DateTime      @default(now())
  sessions      Session[]
  lessonPlans   LessonPlan[]
}

model Session {
  id          String       @id @default(cuid())
  title       String
  messages    Json
  subject     String
  createdAt   DateTime     @default(now())
  user        User         @relation(fields: [userId], references: [id])
  userId      String
  lessonPlan  LessonPlan?
}

model LessonPlan {
  id          String    @id @default(cuid())
  structure   Json
  blobUrl     String?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  session     Session   @relation(fields: [sessionId], references: [id])
  sessionId   String    @unique
}